# First run uses SQLite so the prototype can start without Docker/PostgreSQL.
# After PostgreSQL is installed, replace DATABASE_URL with:
# postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/bakikhata
DATABASE_URL=sqlite:///./data/bakikhata.db
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-BEFORE-REAL-USE
JWT_EXPIRE_MINUTES=10080
APP_ENV=development

# Google Identity Services Web OAuth Client ID (public identifier, not a secret)
GOOGLE_CLIENT_ID=


# Firebase Authentication Web App configuration (public client configuration).
# Get these values from Firebase Console > Project settings > Your apps > Web app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Legacy direct Google Identity Services setting (not used by the Firebase login UI).
GOOGLE_CLIENT_ID=
